# ---------- Server ----------
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---------- Database ----------
# DB_URL is used by the app, DATABASE_URL by node-pg-migrate. Point both at the same database.
DB_URL=postgres://postgres:password@localhost:5432/alhasad
DATABASE_URL=postgres://postgres:password@localhost:5432/alhasad

# ---------- JWT (use long random strings) ----------
ACCESS_JWT_SECRET=change-me
REFRESH_JWT_SECRET=change-me-too

# ---------- Seed data (dev only) ----------
# Password for every seeded test account, e.g. admin@alhasad.test
SEED_PASSWORD=Password123!
